# Copy to .env and set your own password. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# SQL Server rejects weak passwords: at least 8 characters from three of the four
# categories (upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Signs the login tokens (JWT). At least 32 characters; random, not a word.
# Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=ChangeMe_generate-with-openssl-rand-base64-48

# Passwords for the two demo logins, created on first start:
#   werkstatt  (Mechanic: orders, line items, status up to "Fertig")
#   buero      (Office:   everything, incl. invoicing, master data, report)
DEMO_MECHANIC_PASSWORD=ChangeMe_werkstatt
DEMO_OFFICE_PASSWORD=ChangeMe_buero
