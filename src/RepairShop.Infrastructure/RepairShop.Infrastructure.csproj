<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RepairShop.Application\RepairShop.Application.csproj" />
    <ProjectReference Include="..\RepairShop.Domain\RepairShop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!--
      Transitive pin: Microsoft.Data.SqlClient still pulls in Pkcs 9.0.x, which has
      known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). With warnings as
      errors the audit fails the build, so the patched version is lifted explicitly.
      Remove once SqlClient references a fixed version itself.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Password hashing (PBKDF2) without pulling in all of ASP.NET Core Identity. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <!-- Same IdentityModel line as Microsoft.AspNetCore.Authentication.JwtBearer 10.0.14,
         so issuing (here) and validating (API) use one implementation. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>
</Project>
